+/// Habittart: whether two invite links are for the same file on the same server or host (the
+/// token, name and order of the parameters don't matter).
+fn same_file(a: &str, b: &str) -> bool {
+    fn key(link: &str) -> Option<(String, String)> {
+        let query = link.split_once('?')?.1;
+        let param = |k: &str| query.split('&').find_map(|kv| kv.split_once('=').filter(|(n, _)| *n == k).map(|(_, v)| v.trim_end_matches('/').to_ascii_lowercase()));
+        let place = param("server").or_else(|| param("host")).or_else(|| link.split_once('?').map(|(h, _)| h.trim_end_matches('/').to_ascii_lowercase()))?;
+        let file = param("file").or_else(|| param("code"))?;
+        Some((place, file))
+    }
+    a == b || key(a).is_some_and(|k| Some(k) == key(b))
+}
