+//! Habittart: one FigCraft per computer, opening straight into the shared project, with the same
+//! general settings on every computer.
+//!
+//! * The control channel (the Claude MCP) is on by default, on [`DEFAULT_PORT`].
+//! * A second start hands its files and invite link to the FigCraft already running (over that
+//!   channel) and quits, so double-clicks, links and the MCP never leave two apps open.
+//! * `habittart-autojoin.txt` in the settings folder holds an invite link: a start with nothing
+//!   else to open joins it, so the app opens in the online project.
+//! * `habittart-settings.json` (`{"prefs": {…}}`) holds the shared general settings: whenever the
+//!   file changes they are applied over the local ones (and then kept like any other change).
+
+use std::io::{BufRead, BufReader, Write};
+use std::net::{SocketAddr, TcpStream};
+use std::path::Path;
+use std::time::Duration;
+
+use figcraft_engine::Prefs;
+use serde_json::{Value, json};
+
+/// The control channel's port when neither `--control` nor `FIGCRAFT_CONTROL_PORT` gives one.
+pub const DEFAULT_PORT: u16 = 7979;
+
+const AUTOJOIN: &str = "habittart-autojoin.txt";
+const SETTINGS: &str = "habittart-settings.json";
+const APPLIED: &str = "habittart-settings.applied";
+
+/// When a FigCraft already answers on `port`: give it `files` and `join`, bring it to the front
+/// and return true (this start should quit). False when none is running.
+pub fn forward(port: u16, files: &[String], join: Option<&str>) -> bool {
+    let addr = SocketAddr::from(([127, 0, 0, 1], port));
+    let Ok(stream) = TcpStream::connect_timeout(&addr, Duration::from_millis(400)) else { return false };
+    let _ = stream.set_read_timeout(Some(Duration::from_secs(10)));
+    let _ = stream.set_write_timeout(Some(Duration::from_secs(5)));
+    let mut requests = Vec::new();
+    for f in files {
+        let path = std::path::absolute(f).map(|p| p.to_string_lossy().into_owned()).unwrap_or_else(|_| f.clone());
+        requests.push(json!({"method": "engine.execute", "params": {"command": "file.open", "params": {"path": path}}}));
+    }
+    if let Some(link) = join {
+        requests.push(json!({"method": "engine.execute", "params": {"command": "collab.join", "params": {"link": link}}}));
+    }
+    requests.push(json!({"method": "window.focus", "params": {"id": 0}}));
+    let mut reader = BufReader::new(match stream.try_clone() {
+        Ok(s) => s,
+        Err(_) => return true,
+    });
+    let mut writer = stream;
+    for (i, mut r) in requests.into_iter().enumerate() {
+        r["id"] = json!(i + 1);
+        if writeln!(writer, "{r}").is_err() {
+            break;
+        }
+        let mut line = String::new();
+        if reader.read_line(&mut line).is_err() {
+            break;
+        }
+        log::info!("habittart: handed to the running FigCraft: {}", line.trim());
+    }
+    true
+}
+
+/// The invite link the app opens into when it starts with nothing else to open.
+pub fn autojoin(dir: Option<&Path>) -> Option<String> {
+    if let Some(l) = std::env::var("FIGCRAFT_AUTOJOIN").ok().filter(|l| crate::args::is_invite(l.trim())) {
+        return Some(l.trim().to_string());
+    }
+    let text = std::fs::read_to_string(dir?.join(AUTOJOIN)).ok()?;
+    text.split_whitespace().find(|w| crate::args::is_invite(w)).map(str::to_string)
+}
+
+/// Stable hash of the settings file (FNV-1a), to apply each version once.
+fn hash(s: &str) -> String {
+    let mut h: u64 = 0xcbf2_9ce4_8422_2325;
+    for b in s.bytes() {
+        h ^= u64::from(b);
+        h = h.wrapping_mul(0x0100_0000_01b3);
+    }
+    format!("{h:016x}")
+}
+
+/// Apply the shared settings over `prefs` when the file changed since they were last applied;
+/// true when `prefs` changed (save them).
+pub fn apply_settings(dir: Option<&Path>, prefs: &mut Prefs) -> bool {
+    let Some(dir) = dir else { return false };
+    let Ok(text) = std::fs::read_to_string(dir.join(SETTINGS)) else { return false };
+    let h = hash(&text);
+    if std::fs::read_to_string(dir.join(APPLIED)).is_ok_and(|a| a.trim() == h) {
+        return false;
+    }
+    let shared = match serde_json::from_str::<Value>(&text) {
+        Ok(v) => v.get("prefs").cloned().unwrap_or(v),
+        Err(e) => {
+            log::warn!("habittart: {SETTINGS} isn't valid JSON: {e}");
+            return false;
+        }
+    };
+    let Some(shared) = shared.as_object() else { return false };
+    let Ok(mut current) = serde_json::to_value(&*prefs) else { return false };
+    let Some(obj) = current.as_object_mut() else { return false };
+    for (k, v) in shared {
+        // Never these: they are this computer's own.
+        if matches!(k.as_str(), "recent_files" | "online_files" | "plugins" | "plugin_settings") {
+            continue;
+        }
+        obj.insert(k.clone(), v.clone());
+    }
+    let changed = match serde_json::from_value::<Prefs>(current) {
+        Ok(p) => {
+            let changed = p != *prefs;
+            *prefs = p;
+            changed
+        }
+        Err(e) => {
+            log::warn!("habittart: {SETTINGS}: {e}");
+            return false;
+        }
+    };
+    let _ = std::fs::create_dir_all(dir).and_then(|()| std::fs::write(dir.join(APPLIED), &h));
+    log::info!("habittart: shared settings applied ({h})");
+    changed
+}
