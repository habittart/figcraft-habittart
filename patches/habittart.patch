+/// Adobe Fonts keeps its activated fonts in a hidden `livetype` folder, without a font extension on
+/// Windows (`.5560.otf` on macOS).
+fn in_adobe_fonts(path: &std::path::Path) -> bool {
+    path.components().any(|c| c.as_os_str() == "livetype")
+}
+
+/// An OpenType, TrueType or collection file, by its first four bytes.
+fn looks_like_font(path: &std::path::Path) -> bool {
+    use std::io::Read;
+    let mut magic = [0u8; 4];
+    std::fs::File::open(path).and_then(|mut f| f.read_exact(&mut magic)).is_ok()
+        && matches!(&magic, b"OTTO" | b"ttcf" | b"true" | [0, 1, 0, 0])
+}
+
 /// The parts of a font file the scan reads: headers, table directories and `name` tables, at their
 /// offsets in a zeroed buffer of the file's length (reading whole files was most of the scan).
 fn index_bytes(path: &std::path::Path, len: usize) -> Option<Vec<u8>> {
